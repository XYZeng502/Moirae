# Set these in your shell. This project does not automatically load .env files.
MOIRAE_API_KEY=
MOIRAE_BASE_URL=https://api.minimax.chat/v1
VISION_AGENT_MODEL=MiniMax-M3
TEXT_AGENT_MODEL=MiniMax-M3
JUDGE_AGENT_MODEL=MiniMax-M3

# All evidence belonging to one dataset belongs below this root.
ANDROID_EVIDENCE_DATASET_ROOT=./data
MULTI_AGENT_REPORT_DIR=./data/agent_workspace/benign
MULTI_AGENT_OUTPUT_DIR=./outputs/reasoning

# Optional collection configuration: use local SDK executables or PATH defaults.
ANDROID_ADB=adb
ANDROID_AAPT=aapt
ANDROID_EMULATOR=emulator
ANDROID_AVD=
DROIDBOT_ROOT=./external/droidbot
MOIRAE_APK_DIR=./data/apks
LLM_REASONING_TOOL_LOGS=1
